# API Configuration
# For local development against the local FastAPI backend:
#   VITE_API_URL=http://localhost:5001
#
# For local development against the deployed Render backend:
#   VITE_API_URL=https://dhruv-40xa.onrender.com
#
# For production deployment, set this in your hosting platform's environment variables.
VITE_API_URL=

# Set to "true" to show the demo-login helper on the login page
VITE_DEMO_MODE=

# Set to "true" to auto-login when tapping a demo card (default: off)
VITE_DEMO_AUTOLOGIN=
