# Database Configuration
# In production on Render, use the PostgreSQL connection URL provided by Render or Supabase
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# JWT Authentication
# In production, use a strong 256-bit random secret string (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET_KEY=

# CORS Configuration
# Comma-separated list of allowed origins (e.g. your deployed frontend URL on Vercel/Netlify/Render)
# Localhost dev ports (5173, 4173, 3000, 5001) are enabled by default
FRONTEND_URL=

# Mode Configuration
# Set to 'false' (or leave unset) for Central Cloud Hub deployment (Render)
# Set to 'true' only when running as an edge station node on-site
STATION_MODE=false
STATION_ID=1

# Uplink Configuration (Only used when STATION_MODE=true)
CENTRAL_URL=
UPLINK_USER=
UPLINK_PASSWORD=
